load("//vendor/motorola/sm6475-modules/motorola:moto_modules.bzl", "get_moto_product_modules")
load("//vendor/motorola/sm6475-modules:target_device.bzl", "define_qti_dist")

_platform_map = {
    "parrot": [
        "cuscoi",
        "mona",
        "monai",
        "paro",
        "paros",
    ],
}

[
    define_qti_dist(
        target = product,
        msm_target = msm_target,
        extra_modules = get_moto_product_modules(product),
        dist_prefix = "motorola",
    )
    for msm_target, products in _platform_map.items()
    for product in products
]
